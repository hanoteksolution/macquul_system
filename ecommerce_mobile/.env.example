# Copy to .env and adjust for your setup

EXPO_PUBLIC_API_URL=https://ecommerce.safaritechno.com



# Physical device: npm start → scan QR in Expo Go app (not Chrome).

# NEVER add REACT_NATIVE_PACKAGER_HOSTNAME to .env (causes red-screen protocol error).
# If you see "Cannot assign to property 'protocol'": npm run start:clean
# Also clear in PowerShell: Remove-Item Env:REACT_NATIVE_PACKAGER_HOSTNAME -ErrorAction SilentlyContinue

# npm start auto-detects your LAN IP. Override for one session in PowerShell:

#   $env:EXPO_PACKAGER_HOSTNAME="10.161.1.6"; npm start

# If LAN fails: npm run start:tunnel

# Emulator only: npm run start:localhost


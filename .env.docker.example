# Copy to .env in the project root for docker compose:
#   make env

SECRET_KEY=django-insecure-change-me
DEBUG=True

DB_NAME=ecommerce_db
DB_USER=ecom_user
DB_PASSWORD=strongpassword

# Host ports (Postgres is internal-only unless you add a ports mapping to db)
# On shared VPS: use 8020/3010 if 8001/3003 are taken (see deploy/nginx/)
API_HOST_PORT=8020
CLIENT_HOST_PORT=3002
ADMIN_HOST_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:8020

# Production (ecommerce.safaritechno.com → 88.222.220.238)
# NEXT_PUBLIC_API_URL=https://ecommerce.safaritechno.com
# ALLOWED_HOSTS=localhost,127.0.0.1,ecommerce.safaritechno.com,admin.ecommerce.safaritechno.com
# CORS_ALLOWED_ORIGINS=https://ecommerce.safaritechno.com,https://admin.ecommerce.safaritechno.com
# CSRF_TRUSTED_ORIGINS=https://ecommerce.safaritechno.com,https://admin.ecommerce.safaritechno.com

# Copy to .env in the project root for docker compose:
#   make env

SECRET_KEY=django-insecure-change-me
DEBUG=True

DB_NAME=ecommerce_db
DB_USER=ecom_user
DB_PASSWORD=strongpassword

# Host ports (Postgres is internal-only unless you add a ports mapping to db)
API_HOST_PORT=8001
CLIENT_HOST_PORT=3002
ADMIN_HOST_PORT=3003
NEXT_PUBLIC_API_URL=http://localhost:8001
